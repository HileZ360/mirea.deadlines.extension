{
  "manifest_version": 3,
  "name": "Дедлайны СДО МИРЭА",
  "version": "2.4.0",
  "minimum_chrome_version": "111",
  "description": "Сроки бакалавриата СДО МИРЭА, обратный отсчёт и сохранение Excel.",
  "host_permissions": [
    "https://online-edu.mirea.ru/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://online-edu.mirea.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Дедлайны СДО — открыть окно",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "background": {
    "service_worker": "background.js"
  }
}
